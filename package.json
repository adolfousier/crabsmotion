{
  "name": "crabmotion",
  "version": "1.0.0",
  "description": "OpenCrabs self-portrait motion graphic — minimalist tech style, music-synced, built with Remotion",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render CrabMotion out/crabmotion-en.mp4",
    "render:id": "remotion render CrabMotionID out/crabmotion-id.mp4",
    "render:id:vertical": "remotion render CrabMotionIDVertical out/crabmotion-id-vertical.mp4",
    "render:fr": "remotion render CrabMotionFR out/crabmotion-fr.mp4",
    "render:fr:vertical": "remotion render CrabMotionFRVertical out/crabmotion-fr-vertical.mp4",
    "render:ru": "remotion render CrabMotionRU out/crabmotion-ru.mp4",
    "render:ru:vertical": "remotion render CrabMotionRUVertical out/crabmotion-ru-vertical.mp4",
    "render:pt": "remotion render CrabMotionPT out/crabmotion-pt.mp4",
    "render:pt:vertical": "remotion render CrabMotionPTVertical out/crabmotion-pt-vertical.mp4",
    "render:vertical": "remotion render CrabMotionVertical out/crabmotion-en-vertical.mp4",
    "still": "remotion still CrabMotion out/poster.png --frame=180",
    "test": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/google-fonts": "4.0.347",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.347"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.347",
    "@types/react": "19.2.0",
    "typescript": "5.9.3"
  }
}
